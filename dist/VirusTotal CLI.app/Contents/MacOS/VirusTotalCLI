#!/bin/zsh

set -u

/usr/bin/osascript <<'APPLESCRIPT'
tell application "Terminal"
  activate
  do script "clear; export PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; if command -v vt >/dev/null 2>&1; then echo 'VirusTotal CLI'; echo '=============='; vt version; echo; echo 'Ready. Examples:'; echo '  vt file <SHA256>'; echo '  vt url <URL>'; echo '  vt scan file <FILE>'; echo '  vt help'; else echo 'VirusTotal CLI was not found.'; echo; echo 'Install it with:'; echo '  brew install virustotal-cli'; fi; echo"
end tell
APPLESCRIPT
